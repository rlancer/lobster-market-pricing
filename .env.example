# Root .env — shared secret reference for the monorepo (loader + screener).
# Copy to `.env` and fill in. This file is gitignored; `.env.example` is tracked.
#
# mise does NOT auto-load .env — export these into your shell before running
# `wrangler r2 sql query` or the loader tools, or source .env manually.

# --- R2 SQL / Data Catalog (read) ---------------------------------------------
# Cloudflare API token with R2 SQL Read on the lake bucket. Same token under
# two names, consumed by different tools:
#   R2_SQL_TOKEN              → screener Worker secret (worker/.dev.vars)
#   WRANGLER_R2_SQL_AUTH_TOKEN → `wrangler r2 sql query` (loader validation)
R2_SQL_TOKEN=
WRANGLER_R2_SQL_AUTH_TOKEN=

# --- R2 Data Catalog management (write) --------------------------------------
# Cloudflare API token with R2 Storage Admin R&W + R2 Data Catalog R&W. Used for
# table create/drop via the Iceberg REST catalog and as `--catalog-token` when
# creating r2-data-catalog Pipeline sinks. ALSO STORED IN GITHUB SECRETS.
R2_DATA_CATALOG_TOKEN=

# --- Pipeline HTTP-ingest auth (write) ---------------------------------------
# Cloudflare API token with the **Workers Pipelines -> Send** permission. This is
# the only token the authenticated cboe_*_v2 streams accept (Bearer). Rotated +
# stored in GitHub 2026-08-08; keep it in sync with the Worker secret
# (cd loader && printf '%s' "$env:PIPELINE_AUTH_TOKEN" | npx wrangler secret put PIPELINE_AUTH_TOKEN).
PIPELINE_AUTH_TOKEN=

# OpenFIGI symbology (write + live resolve) ------------------------------------
# OpenFIGI Mapping API key. Used by loader/tools/figi_map.ts to seed
# options.securities / options.symbol_history, AND by the screener Worker for
# live /api/research + Copilot research_ticker normalization.
# Never commit the value; this is just the placeholder.
#   https://www.openfigi.com/api
OPEN_FIGI=

# --- OpenRouter site key (free chats) ----------------------------------------
# The site's OpenRouter API key funding free anonymous Copilot chats. Mirrored
# into worker/.dev.vars for local `wrangler dev`, and deployed as a Worker
# secret + GitHub secret (OPEN_ROUTER_KEY), same as TAVILY_API_KEY. Never commit
# the value; never send it to the browser (the /api/free/* proxy is the only
# consumer). The credit balance on this key is the free-tier throttle.
OPEN_ROUTER_KEY=

# --- Chat history (admin-only lake table) ------------------------------------
# Admin bearer token guarding GET /api/admin/chat_history (transcripts with
# ip/user_id) and private lake SQL. Tool-call debug is public at
# GET /api/tool_calls — no token. Generate a long random value; stored as a
# Worker secret (ADMIN_TOKEN) + GitHub secret. Never commit.
ADMIN_TOKEN=

# Ingest endpoint of the cboe_chat_history_v2 stream (the URL subdomain IS the
# credential — same model as the loader's PIPELINE_*_URLs). POST
# /api/chat/history publishes one record per chat turn to options.chat_history;
# stream ingest is Bearer-authenticated with PIPELINE_AUTH_TOKEN above.
PIPELINE_CHAT_HISTORY_URL=

# --- Charles Schwab Trader API (optional) ------------------------------------
# App key + secret from https://developer.schwab.com. Mirrored as Worker secrets
# SCHWAB_CLIENT_ID / SCHWAB_CLIENT_SECRET (+ GitHub secrets). Register callbacks
# comma-separated (HTTPS, no trailing slash):
#   https://api.lobster.mp/api/schwab/callback,https://api-dev.lobster.mp/api/schwab/callback
# After portal edits wait for Ready for Use. Full notes: README “Charles Schwab connect”.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=

# Non-secret lake connection values (also set as Worker vars in worker/wrangler.jsonc):
#   R2_SQL_ACCOUNT_ID=3315bb3e7d2e3556bfea6fb3947a890e
#   R2_SQL_BUCKET=cboe-options-data
