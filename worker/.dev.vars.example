# screener Worker local-dev secrets (worker/.dev.vars).
# Copy to `.dev.vars` and fill in. This file is gitignored; the example is tracked.
# Deploy the secret once with: cd worker && npx wrangler secret put R2_SQL_TOKEN

R2_SQL_TOKEN=

# OpenRouter site key used only by the Worker's server-side chat loop.
# Mirror the value from the root `.env` OPEN_ROUTER_KEY. Deployed as a Worker
# secret (`wrangler secret put OPEN_ROUTER_KEY`) + a GitHub secret for redeploys.
# Never commit the value or expose it to browser code.
OPEN_ROUTER_KEY=

# OpenFIGI Mapping API key — live ticker normalize for /api/research and the
# Chat research_ticker tool (same key as loader figi_map). Optional: without
# it, resolution falls back to lake options.securities then ticker-derived ids.
OPEN_FIGI=

# Optional override for local dev; defaults to the production loader.
LOADER_BASE_URL=https://cboe-to-r2.robertlancer.workers.dev

# Same bearer as loader LOADER_TOKEN — required for on-demand ticker enrollment
# (Chat/research auto-enroll + POST /api/symbols/enroll). Deploy with:
#   cd worker && npx wrangler secret put LOADER_TOKEN
LOADER_TOKEN=

# Admin bearer token for ADMIN_TOKEN-only surfaces (private lake SQL) and as
# an alternate gate for session-admin APIs (chat history, users, bots). Session
# admins can call GET /api/admin/chat_history with a cookie; scripts use Bearer.
# Generate a long random value; deployed via `wrangler secret put ADMIN_TOKEN`
# + a GitHub secret. No value = bearer paths 401 and /api/query stays closed
# to chat_history.
ADMIN_TOKEN=

# Fine-grained GitHub PAT for the timeline moderation improvement reporter.
# Needs Issues: Read and write on rlancer/lobster-market-pricing (or
# IMPROVEMENT_ISSUE_REPO). Optional — unset = quality gate still runs, no
# GitHub issues are filed. Deploy with:
#   cd worker && npx wrangler secret put IMPROVEMENT_ISSUE_TOKEN
# Mirror as a GitHub Actions secret so deploy.yml can reinject it.
IMPROVEMENT_ISSUE_TOKEN=

# Optional owner/repo override (default rlancer/lobster-market-pricing).
# IMPROVEMENT_ISSUE_REPO=rlancer/lobster-market-pricing

# Better Auth (optional Chat login — Google OAuth only, no passwords).
# BETTER_AUTH_SECRET must be a long random string. Cookie domain is derived
# from the request host (lobster.mp siblings vs localhost). Mirror the same
# three values as Worker / GitHub secrets. Leave blank to keep chat anonymous.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Charles Schwab Trader API OAuth (optional — Connect Schwab on Account).
# App key + secret from https://developer.schwab.com. Register Callback URLs
# (comma-separated in the portal; HTTPS; no trailing slash):
#   https://api.lobster.mp/api/schwab/callback,https://api-dev.lobster.mp/api/schwab/callback
# OAuth: authorize/token at https://api.schwabapi.com/v1/oauth/{authorize,token}
# After any portal edit wait for Ready for Use (Pending → login loops).
# Ops notes + external refs: repo README → “Charles Schwab connect”.
# Deploy: wrangler secret put SCHWAB_CLIENT_ID / SCHWAB_CLIENT_SECRET
# (+ GitHub secrets so deploy.yml reinjects). Optional SCHWAB_REDIRECT_URI
# override must match a registered callback exactly.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
# SCHWAB_REDIRECT_URI=https://api.lobster.mp/api/schwab/callback

# Pipeline stream ingest for chat history (cboe_chat_history_v2) —
# POST /api/chat/history publishes one record per chat turn to
# options.chat_history. The URL subdomain is the credential: set as a Worker
# secret, never commit. Posting without a value is a silent no-op (dev).
PIPELINE_CHAT_HISTORY_URL=

# Pipelines → Send scoped API token (same value as the loader's
# PIPELINE_AUTH_TOKEN in the root .env) authorizing the stream ingest POST.
PIPELINE_AUTH_TOKEN=
