{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "screener-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "vars": {
    "R2_SQL_ACCOUNT_ID": "3315bb3e7d2e3556bfea6fb3947a890e",
    "R2_SQL_BUCKET": "cboe-options-data",
    "CORS_ORIGIN": "*",
    "LOADER_BASE_URL": "https://cboe-to-r2.robertlancer.workers.dev",
    "COPILOT_MODEL": "deepseek/deepseek-v4-flash-0731",
    "COPILOT_REASONING_EFFORT": "high",
    "COPILOT_MAX_OUTPUT_TOKENS": "8192",
    "COPILOT_MAX_HISTORY_CHARS": "48000"
  },
  "durable_objects": {
    "bindings": [
      { "name": "CopilotAgent", "class_name": "CopilotAgent" }
    ]
  },
  "exports": {
    "CopilotAgent": { "type": "durable-object", "storage": "sqlite" }
  },
  // D1 cache for the expensive lake-schema payload (/api/tables). The schema
  // is read on every AI chat question and the SQL Lab sidebar; recomputing it
  // costs several R2 SQL round trips, so the computed payload (tables +
  // columns + row counts + sample rows) lives here and only refreshes when
  // stale or on ?force=1. Migration in ./migrations is applied on deploy.
  "d1_databases": [
    {
      "binding": "SCHEMA_DB",
      "database_name": "screener-schema-cache",
      "database_id": "b0efdfb0-9774-45ea-a6f2-e12361bcb4dd",
      "migrations_dir": "./migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
