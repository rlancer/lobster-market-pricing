# Copy to loader/.env (gitignored) — never commit real keys.
# Then from loader/:  node tools/put_kalshi_secrets.mjs --deploy
#
# Prefer a PEM *file* (easiest for multi-line keys):

KALSHI_ACCESS_KEY_ID=your-kalshi-key-id-uuid-here
KALSHI_PRIVATE_KEY_FILE=./kalshi-readonly.key

# Put the downloaded Kalshi .key next to this file as kalshi-readonly.key
# (or any path; relative paths are resolved from loader/).
#
# Alternative — inline PEM (double quotes, real newlines OK):
#
# KALSHI_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----
# MIIE...
# -----END RSA PRIVATE KEY-----"
