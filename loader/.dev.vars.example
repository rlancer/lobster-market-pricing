# loader Worker local-dev secrets (loader/.dev.vars).
# Copy to `.dev.vars` and fill in. This file is gitignored; the example is tracked.
#
# GitHub Actions secrets are the project's de-facto secrets manager — every
# token below is also stored there (`gh secret set NAME`) so it is never lost.
#
# LOADER_TOKEN protects the loader Worker /run, /loop/trigger and /jobs/*/trigger
# endpoints. Deploy once with:  cd loader && npx wrangler secret put LOADER_TOKEN
#
# Pipeline ingest URLs (PIPELINE_*_URL) are write-capable endpoints for the R2
# lake — they must NEVER be committed. Deploy them as Wrangler secrets (streams
# are authenticated; PIPELINE_AUTH_TOKEN must be a Cloudflare API token with the
# **Workers Pipelines -> Send** permission — other tokens get 401 code 1014):
#   npx wrangler secret put PIPELINE_RUNS_URL
#   npx wrangler secret put PIPELINE_CONTRACTS_URL
#   npx wrangler secret put PIPELINE_ERRORS_URL        # leave empty to disable
#   npx wrangler secret put PIPELINE_OHLC_URL          # stream cboe_ohlc_v2
#   npx wrangler secret put PIPELINE_REALIZED_VOL_URL  # stream cboe_realized_vol_v2
#   npx wrangler secret put PIPELINE_CORPORATE_ACTIONS_URL  # stream cboe_corporate_actions_v2
#   npx wrangler secret put PIPELINE_SECURITIES_URL    # stream cboe_securities_v2 (symbology master)
#   npx wrangler secret put PIPELINE_SYMBOL_HISTORY_URL    # stream cboe_symbol_history_v2
#   npx wrangler secret put PIPELINE_UNDERLYING_SNAPSHOTS_URL # stream cboe_underlying_snapshots_v2
#   npx wrangler secret put PIPELINE_EARNINGS_URL       # stream cboe_earnings_v2 (earnings-daily job)
#   npx wrangler secret put PIPELINE_ECON_URL           # stream cboe_econ_v2 (fred-econ-daily job)
#   npx wrangler secret put PIPELINE_ETF_PROFILES_URL   # stream cboe_etf_profiles_v2 (etf-daily job)
#   npx wrangler secret put PIPELINE_ETF_HOLDINGS_URL   # stream cboe_etf_holdings_v2 (etf-daily job)
#   npx wrangler secret put PIPELINE_FUNDAMENTALS_URL   # stream cboe_fundamentals_v2 (fundamentals-daily job)
#   npx wrangler secret put PIPELINE_FUTURES_SETTLEMENTS_URL  # stream cboe_futures_settlements_v2 (cfe-futures-daily)
#   npx wrangler secret put PIPELINE_FUTURES_QUOTES_URL       # stream cboe_futures_quotes_v2 (cfe-futures-daily)
#   npx wrangler secret put FRED_API_KEY                # St. Louis Fed key for the econ calendar (fred-econ-daily)
#   npx wrangler secret put PIPELINE_AUTH_TOKEN        # required (streams are authenticated)
#
# For local runs against the deployed Worker, leave the URLs blank here and let
# the Worker forward them. For local container dev (WRITE_MODE=pipeline), set
# the rotated URLs and PIPELINE_AUTH_TOKEN below.

LOADER_TOKEN=
PIPELINE_RUNS_URL=
PIPELINE_CONTRACTS_URL=
PIPELINE_ERRORS_URL=
PIPELINE_OHLC_URL=
PIPELINE_REALIZED_VOL_URL=
PIPELINE_CORPORATE_ACTIONS_URL=
PIPELINE_SECURITIES_URL=
PIPELINE_SYMBOL_HISTORY_URL=
PIPELINE_UNDERLYING_SNAPSHOTS_URL=
PIPELINE_EARNINGS_URL=
PIPELINE_ECON_URL=
PIPELINE_ETF_PROFILES_URL=
PIPELINE_ETF_HOLDINGS_URL=
PIPELINE_FUNDAMENTALS_URL=
PIPELINE_FUTURES_SETTLEMENTS_URL=
PIPELINE_FUTURES_QUOTES_URL=
FRED_API_KEY=
PIPELINE_AUTH_TOKEN=