{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cboe-to-r2",
  "main": "src/index.js",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "vars": {
    // PIPELINE_*_URL and PIPELINE_AUTH_TOKEN are deployed as Wrangler secrets
    // (`wrangler secret put`). The ingest URLs are unauthenticated write
    // endpoints whose subdomain IS the credential, so they must never be
    // committed. See SECURITY-AUDIT.md (CRITICAL) and loader/.dev.vars.example.

    // Continuous-loader tuning (safe, cost-conscious defaults — see README).
    // Master switch for the background loop; "false" disables arming entirely.
    "CONTINUOUS_LOADER_ENABLED": "true",
    // Symbols per /run pass (runSymbols bounded concurrency). Kept modest: the
    // per-symbol contract publish path is serialized for deterministic output,
    // so a large batch stretches the pass and buffers thousands of parsed
    // records in the DO isolate at once (a 250-symbol batch OOM'd the DO and
    // hit the run timeout). At 40 a pass completes well inside the timeout;
    // the serialized-publish throughput means a full 503-symbol refresh takes
    // longer than the 15-min cadence, so the universe intentionally refreshes
    // over multiple passes and data can age beyond 15 min until the cadence is
    // re-tuned (see README "Safe defaults and tuning").
    "LOADER_BATCH_SIZE": 40,
    // Seconds between passes (alarm fires, picks the due batch, re-arms).
    "LOADER_POLL_INTERVAL_SECONDS": 60,
    // Seconds after a successful reload before a symbol is due again (~15 min).
    "LOADER_CADENCE_SECONDS": 900,
    // Exponential backoff on failure: base seconds, doubled up to the cap.
    "LOADER_BACKOFF_BASE_SECONDS": 60,
    "LOADER_BACKOFF_CAP_SECONDS": 1800,
    // Safety net for a pass (runSymbols). On timeout the batch backs off and is
    // retried — the loop stays healthy. Sized for a full-universe concurrent
    // pass (~3–6 min at batch 250 / concurrency 8).
    "LOADER_RUN_TIMEOUT_SECONDS": 600,
    // Concurrency for CBOE fetches + Pipeline publishes within a pass
    // (runSymbols promise semaphore). I/O-bound, so it scales near-linearly
    // without extra CPU.
    "SYMBOL_CONCURRENCY": 8,
    // Market-hours gating: skip passes and sleep the alarm loop until the
    // next open when the US regular session is closed (no new CBOE data).
    // Times are minutes-since-midnight ET. Set MARKET_HOURS_ENABLED="false"
    // to always run.
    "MARKET_HOURS_ENABLED": "true",
    "MARKET_OPEN_MINUTES": 570,
    "MARKET_CLOSE_MINUTES": 960,
    "MARKET_EARLY_CLOSE_MINUTES": 780
  },
  "d1_databases": [
    {
      // Per-symbol state + loader meta. Create the database in the dashboard
      // (or `wrangler d1 create cboe-loader-state`) and replace database_id
      // below. Migrations in ./migrations are applied on deploy.
      "binding": "LOADER_DB",
      "database_name": "cboe-loader-state",
      "database_id": "103bff64-1009-4733-8d3a-a396d0051523",
      "migrations_dir": "./migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ETL_SCHEDULER",
        "class_name": "EtlScheduler"
      }
    ]
  },
  "migrations": [
    {
      // Original CboeLoaderContainer (container-backed DO) binding — the chain
      // must start from this class so fresh local replays stay valid.
      "tag": "v1",
      "new_sqlite_classes": ["CboeLoaderContainer"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["CboeContinuousLoader"]
    },
    {
      // The CboeLoaderContainer (container-backed DO) is retired — delete it.
      "tag": "v3",
      "deleted_classes": ["CboeLoaderContainer"]
    },
    {
      // Phase 1: CboeContinuousLoader is generalized into the job-agnostic
      // EtlScheduler. Retire the old class and add the new one.
      "tag": "v4",
      "new_sqlite_classes": ["EtlScheduler"],
      "deleted_classes": ["CboeContinuousLoader"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
