{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cboe-to-r2",
  "main": "src/index.js",
  "compatibility_date": "2026-08-05",
  "vars": {
    // Off by default: flip to "true" (dashboard → Settings → Variables) to
    // enable the nightly scheduled S&P 500 refresh AFTER full-refresh
    // validation is complete (see NEXT_STEPS.md). See the `triggers.crons`
    // entry below.
    "ENABLE_SCHEDULED_REFRESH": "false"
    // PIPELINE_*_URL and PIPELINE_AUTH_TOKEN are deployed as Wrangler secrets
    // (`wrangler secret put`). The ingest URLs are unauthenticated write
    // endpoints whose subdomain IS the credential, so they must never be
    // committed. See SECURITY-AUDIT.md (CRITICAL) and loader/.dev.vars.example.
  },
  // Nightly scheduled refresh. Inert unless ENABLE_SCHEDULED_REFRESH is "true"
  // (the worker's `scheduled` handler gates on it).
  "triggers": {
    "crons": ["0 9 * * *"]
  },
  "containers": [
    {
      "class_name": "CboeLoaderContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CBOE_LOADER",
        "class_name": "CboeLoaderContainer"
      }
    ]
  },
  "workflows": [
    {
      "binding": "SCHEDULED_REFRESH",
      "name": "scheduled-refresh",
      "class_name": "ScheduledRefreshWorkflow"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CboeLoaderContainer"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
