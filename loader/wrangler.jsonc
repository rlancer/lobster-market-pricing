{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cboe-to-r2",
  "main": "src/index.js",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "vars": {
    // PIPELINE_*_URL and PIPELINE_AUTH_TOKEN are deployed as Wrangler secrets
    // (`wrangler secret put`). The ingest URLs are unauthenticated write
    // endpoints whose subdomain IS the credential, so they must never be
    // committed. See SECURITY-AUDIT.md (CRITICAL) and loader/.dev.vars.example.

    // Continuous-loader tuning (safe, cost-conscious defaults — see README).
    // Master switch for the background loop; "false" disables arming entirely.
    "CONTINUOUS_LOADER_ENABLED": "true",
    // Symbols per /run batch. Sized so the container's concurrent workers can
    // cycle the universe in a couple of passes: at SYMBOL_CONCURRENCY=8 and the
    // container's ~4.3s/symbol serial-equivalent, a 250-symbol batch is ~2 min,
    // two passes cover all ~503 in ~5 min — comfortably inside the 15-min
    // cadence. Kept just under the full 503 so a single stuck symbol can't hold
    // a whole run hostage for the full timeout.
    "LOADER_BATCH_SIZE": 250,
    // Seconds between passes (alarm fires, picks the due batch, re-arms).
    "LOADER_POLL_INTERVAL_SECONDS": 60,
    // Seconds after a successful reload before a symbol is due again (~15 min).
    "LOADER_CADENCE_SECONDS": 900,
    // Exponential backoff on failure: base seconds, doubled up to the cap.
    "LOADER_BACKOFF_BASE_SECONDS": 60,
    "LOADER_BACKOFF_CAP_SECONDS": 1800,
    // Abort timeout (s) for the internal container /run call. On timeout the
    // whole batch is backed off and retried — the loop stays healthy. Raised to
    // fit a full-universe concurrent pass (~3–6 min at batch 250 / concurrency 8).
    "LOADER_RUN_TIMEOUT_SECONDS": 600,
    // Market-hours gating: skip passes and sleep the alarm loop until the
    // next open when the US regular session is closed (no new CBOE data).
    // Times are minutes-since-midnight ET. Set MARKET_HOURS_ENABLED="false"
    // to always run.
    "MARKET_HOURS_ENABLED": "true",
    "MARKET_OPEN_MINUTES": 570,
    "MARKET_CLOSE_MINUTES": 960,
    "MARKET_EARLY_CLOSE_MINUTES": 780
  },
  "containers": [
    {
      "class_name": "CboeLoaderContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "d1_databases": [
    {
      // Per-symbol state + loader meta. Create the database in the dashboard
      // (or `wrangler d1 create cboe-loader-state`) and replace database_id
      // below. Migrations in ./migrations are applied on deploy.
      "binding": "LOADER_DB",
      "database_name": "cboe-loader-state",
      "database_id": "103bff64-1009-4733-8d3a-a396d0051523",
      "migrations_dir": "./migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CBOE_LOADER",
        "class_name": "CboeLoaderContainer"
      },
      {
        "name": "CBOE_CONTINUOUS_LOADER",
        "class_name": "CboeContinuousLoader"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CboeLoaderContainer"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["CboeContinuousLoader"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
